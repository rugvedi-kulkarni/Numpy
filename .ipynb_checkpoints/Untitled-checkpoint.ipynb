   "source": [
    "# copy in python list vs view in numpy arrays\n",
    "py = [1, 2, 3, 4, 5]\n",
    "print(py)\n",
    "li = py[1:3]\n",
    "li[0] = 200\n",
    "print(li)\n",
    "print(py)\n",
    "\n",
    "arr = np.array(py)\n",
    "print(arr)\n",
    "a = arr[1:3].copy()\n",
    "a[0] = 200\n",
    "print(a)\n",
    "print(arr)"
   ]
